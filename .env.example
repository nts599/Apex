# Server
PORT=4000
CLIENT_ORIGIN=http://127.0.0.1:5500

# MySQL
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=apex

# JWT
JWT_SECRET=replace-this-with-a-long-random-string
JWT_EXPIRES_IN=7d

# Email verification codes
VERIFICATION_CODE_TTL_MINUTES=15

# SMTP (Nodemailer). For local dev without a real inbox, use an
# Ethereal test account (https://ethereal.email) or Mailtrap.
SMTP_HOST=smtp.ethereal.email
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Apex <no-reply@apex.app>"
